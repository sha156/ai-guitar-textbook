\newcommand{\rndot}[1]{\fill (#1+0.30,0.05) circle (0.045);}
\newcommand{\rnflag}[1]{%
  \draw[line width=0.9pt] (#1+0.12,1)
    .. controls (#1+0.38,0.78) and (#1+0.30,0.62) .. (#1+0.34,0.38);}
\newcommand{\rnbeamA}[2]{\draw[line width=2.6pt] (#1+0.12,0.96) -- (#2+0.12,0.96);}
\newcommand{\rnbeamB}[2]{\draw[line width=2.6pt] (#1+0.12,0.78) -- (#2+0.12,0.78);}
