% ============ 9. 指板音位图（横向，任意品数） ============
% \begin{fretboard}[品数]  弦号 1=高音e(上) … 6=低音E(下)
\newenvironment{fretboard}[1][12]{%
  \def\fbfrets{#1}%
  \begin{tikzpicture}[x=0.85cm,y=0.42cm]
    \foreach \s in {1,...,6}{
      \draw[line width={0.4pt+0.1pt*\s}] (0,6-\s) -- (\fbfrets,6-\s);
    }
    \draw[line width=2.4pt] (-0.02,0) -- (-0.02,5);
    \foreach \f in {1,...,\fbfrets}{ \draw[line width=0.6pt] (\f,0) -- (\f,5); }
    \foreach \f in {3,5,7,9,12}{
      \ifnum\f>\fbfrets\relax\else
        \node[gray,font=\scriptsize] at (\f-0.5,-0.9) {\f};
      \fi }
    \foreach \s/\n in {1/e,2/B,3/G,4/D,5/A,6/E}{
      \node[font=\scriptsize\sffamily,left] at (-0.85,6-\s) {\n};
    }
}{\end{tikzpicture}}

% \fbmark[颜色]{弦}{品}{标签}；品=0 为空弦
\newcommand{\fbmark}[4][fbdotcolor]{%
  \ifnum#3=0
    \draw[#1,line width=0.9pt] (-0.45,6-#2) circle (0.16);
    \node[#1,font=\tiny\sffamily] at (-0.45,6-#2) {#4};
  \else
    \fill[#1] (#3-0.5,6-#2) circle (0.21);
    \node[white,font=\tiny\sffamily] at (#3-0.5,6-#2) {#4};
  \fi}

% \fbroot{弦}{品}{标签}：根音红色 + 外圈
\newcommand{\fbroot}[3]{%
  \fbmark[fbrootcolor]{#1}{#2}{#3}%
  \ifnum#2=0
    \draw[fbrootcolor,line width=0.9pt] (-0.45,6-#1) circle (0.24);
  \else
    \draw[fbrootcolor,line width=0.9pt] (#2-0.5,6-#1) circle (0.29);
  \fi}

% ============ 10. 竖版和弦窗格（5 品内） ============
% \begin{chordbox}[起始品号]{和弦名}  起始品号留空=开放把位（画弦枕）
\newenvironment{chordbox}[2][]{%
  \begin{tikzpicture}[x=0.42cm,y=0.5cm,line cap=round,
      baseline=(current bounding box.center)]
    \node[font=\sffamily\bfseries] at (2.5,1.5) {#2};
    \foreach \s in {0,...,5}{\draw[line width=0.55pt] (\s,0) -- (\s,-5);}
    \foreach \f in {0,...,5}{\draw[line width=0.55pt] (0,-\f) -- (5,-\f);}
    \if\relax\detokenize{#1}\relax
      \draw[line width=2.4pt] (-0.04,0.02) -- (5.04,0.02);
    \else
      \node[font=\sffamily\small,anchor=east] at (-0.35,-0.5) {#1};
    \fi
}{\end{tikzpicture}}

% \cbdot[手指号]{弦}{品}（品为窗格内相对品 1-5）
\newcommand{\cbdot}[3][]{%
  \fill[inkGray] (6-#2,0.5-#3) circle (0.17);
  \if\relax\detokenize{#1}\relax\else
    \node[white,font=\tiny\sffamily] at (6-#2,0.5-#3) {#1};\fi}
% \cbbarre[手指号]{品}{从弦}{到弦}
\newcommand{\cbbarre}[4][1]{%
  \draw[inkGray,line width=7pt] (6-#3,0.5-#2) -- (6-#4,0.5-#2);
  \node[white,font=\tiny\sffamily] at ({(12-#3-#4)/2},0.5-#2) {#1};}
\newcommand{\cbopen}[1]{\draw[line width=0.7pt] (6-#1,0.42) circle (0.12);}
\newcommand{\cbmute}[1]{\node[font=\footnotesize] at (6-#1,0.42) {$\times$};}

